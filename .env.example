# Copy to `.env` and adjust for your machine.
# Real environment variables always take precedence over this file.

# dev | test | prod
APP_ENV=dev

# ip:port the HTTP server listens on
BIND_ADDR=127.0.0.1:8080

# pretty | json (defaults: pretty in dev/test, json in prod)
LOG_FORMAT=pretty

# PostgreSQL connection string; required once the database layer is wired up
DATABASE_URL=postgres://jey:jey@localhost:5432/jey

# Session lifetime in days (1..365)
SESSION_TTL_DAYS=30

# Comma-separated list of allowed browser origins, with scheme and without a trailing slash
ALLOWED_ORIGINS=http://localhost:3000
