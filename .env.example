# Copy to `.env` and adjust for your machine.
# Real environment variables always take precedence over this file.

# dev | test | prod
APP_ENV=dev

# ip:port the HTTP server listens on
BIND_ADDR=127.0.0.1:8080

# pretty | json (defaults: pretty in dev/test, json in prod)
LOG_FORMAT=pretty

# PostgreSQL connection string (required)
DATABASE_URL=postgres://jey:jey@localhost:5432/jey

# Apply pending migrations on startup (default: true outside prod)
RUN_MIGRATIONS=true

# Session lifetime in days (1..365)
SESSION_TTL_DAYS=30

# Comma-separated list of allowed browser origins, with scheme and without a trailing slash
ALLOWED_ORIGINS=http://localhost:3000

# Public address of the web client, used in emails
PUBLIC_URL=http://localhost:3000

# From address for outgoing mail
MAIL_FROM=jey@localhost

# Directory for the development mail transport
MAIL_DIR=var/mail

# Where uploaded images are stored (default: var/media)
MEDIA_DIR=var/media

# Per-user storage quota in megabytes (default: 200)
MEDIA_QUOTA_MB=200

# Optional Google Books API key; enables the localized book-search fallback.
GOOGLE_BOOKS_API_KEY=

# Days after account deletion before the purge task removes rows and files.
PURGE_RETENTION_DAYS=30
