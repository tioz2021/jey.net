{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jey.net",
  "version": "0.7.9",
  "identifier": "net.jey.desktop",
  "build": {
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "jey.net",
        "width": 1120,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Personal media catalogue",
    "longDescription": "Local-first personal catalogue for films, series, anime, books and games.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1ODE5RkQ2MEEzMDJCNjcKUldSbkt6QUsxcCtCSlRFUzJjb0pNelhnaVdWSnVwRHJyTzF2K0xFd1cySUxtT3lDMkF4cDZ4RHgK",
      "endpoints": [
        "https://j3ynet.site/downloads/desktop/latest.json"
      ]
    }
  }
}
