# jey.net — reverse proxy and TLS termination.
#
# j3ynet.site is canonical; the sslip.io alias stays available during the
# transition. Caddy obtains and renews certificates automatically.

(jey_app) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# No third-party assets are used, so everything is same-origin.
		# 'unsafe-inline' is needed because Next.js inlines its bootstrap and
		# the theme script; a nonce-based policy is the next step.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
		-X-Powered-By
	}

	# The API enforces tighter per-endpoint limits; this is only a backstop.
	request_body {
		max_size 40MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /health* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /spa* {
		reverse_proxy 127.0.0.1:8080
	}

	# The component playground is a development tool, not part of the product.
	handle /dev* {
		respond "Not found" 404
	}

	# Everything else is the Next.js web client.
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

j3ynet.site {
	import jey_app
}

www.j3ynet.site {
	redir https://j3ynet.site{uri} permanent
}

129-121-149-16.sslip.io {
	import jey_app
}
