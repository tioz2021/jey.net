# Local staging: no production secrets, separate database and ports.
APP_ENV=dev
BIND_ADDR=127.0.0.1:8081
DATABASE_URL=postgres://jey:jey_dev_password@localhost:5432/jey
STAGING_SCHEMA=jey_staging
PUBLIC_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
MEDIA_DIR=var/staging-media
MAIL_DIR=var/staging-mail
RUN_MIGRATIONS=true
SESSION_TTL_DAYS=30
LOG_FORMAT=pretty
ANALYTICS_SALT=local-staging-salt
